# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# IDE and OS
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.DS_Store
Thumbs.db

# Builds and crash reports
*.apk
*.aab
*.unitypackage
*.app
crashlytics-buildid.txt
sysinfo.txt

# Autogenerated
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

!/Tools/RulesHarness/**/*.csproj
/Tools/RulesHarness/**/bin/
/Tools/RulesHarness/**/obj/

/[Aa]ssets/InitTestScene*

__pycache__/
*.pyc

# >>> game-studio-kit
.harness/
.claude/settings.local.json
.kit/backups/
**/Tools/kit/gate/Check/bin/
**/Tools/kit/gate/Check/obj/
**/Tools/kit/gate/CoreTests/bin/
**/Tools/kit/gate/CoreTests/obj/
**/Tools/.locks/
Tools/kit/assetgen/.venv/
Tools/kit/audio/.venv/
Tools/kit/capture/.venv/
Tools/kit/**/__pycache__/
ArtSource/_gen/**/outputs/
_Inbox/
.env
/TestResults/
/Assets/_AgentCaptures/
/Assets/_AgentCaptures.meta
# <<< game-studio-kit

# Gate projects are regenerated with machine-local Unity references.
/Tools/kit/gate/Check/.gen.json
/Tools/kit/gate/Check/Directory.Build.props
/Tools/kit/gate/Check/Runtime.csproj
/Tools/kit/gate/Check/Editor.csproj
/Tools/kit/gate/Check/asmdef/
/Tools/kit/gate/CoreTests/CoreTests.csproj

# Local Unity assistant preferences are not project configuration.
/ProjectSettings/Packages/com.unity.ai.assistant/

# Proprietary Photon SDKs are restored from the official, hash-pinned packages.
/Assets/Photon/
/Assets/Photon.meta

# Unity Performance Testing generates these local build measurements.
/Assets/Resources/PerformanceTestRunInfo.json
/Assets/Resources/PerformanceTestRunInfo.json.meta
/Assets/Resources/PerformanceTestRunSettings.json
/Assets/Resources/PerformanceTestRunSettings.json.meta

/BuildNotes/
/docs/
*.md
!/README.md
