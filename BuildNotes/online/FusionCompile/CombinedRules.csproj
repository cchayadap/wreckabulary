<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Wreckabulary.Rules</AssemblyName>
    <PuzzleRoot Condition="'$(PuzzleRoot)' == ''">../../../../wordbound-puzzle-race</PuzzleRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(PuzzleRoot)/Assets/_Project/Scripts/Rules/**/*.cs" Exclude="$(PuzzleRoot)/Assets/_Project/Scripts/Rules/Wordbound/Online*.cs" />
    <Compile Include="$(PuzzleRoot)/Packages/com.gamestudiokit.core/Runtime/Determinism/*.cs" />
    <Compile Include="../../../Assets/_Project/Scripts/Rules/Wordbound/Online*.cs" />
  </ItemGroup>
</Project>
