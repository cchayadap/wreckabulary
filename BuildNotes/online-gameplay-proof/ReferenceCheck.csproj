    <Reference Include="$(UnityData)/NetStandard/ref/2.1.0/netstandard.dll" Private="false" />
    <Reference Include="$(UnityData)/NetStandard/compat/2.1.0/shims/netfx/mscorlib.dll" Private="false" />
