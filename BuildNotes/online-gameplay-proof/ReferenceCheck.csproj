<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <UnityData Condition="'$(UnityData)' == ''">C:/Program Files/Unity/Hub/Editor/6000.6.3f1/Editor/Data</UnityData>
    <IntegrationRoot Condition="'$(IntegrationRoot)' == ''">../../../wordbound-integration</IntegrationRoot>
    <PuzzleRoot Condition="'$(PuzzleRoot)' == ''">../../../wordbound-puzzle-race</PuzzleRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/_Project/Tests/OnlineGameplay/*.cs" />
