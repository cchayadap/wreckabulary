<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework><LangVersion>9.0</LangVersion><Nullable>disable</Nullable>
    <IsTestProject>true</IsTestProject><IsPackable>false</IsPackable><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RulesSourceRoot Condition="'$(RulesSourceRoot)' == ''">../../../wordbound-integration</RulesSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RulesSourceRoot)/Assets/_Project/Scripts/Rules/**/*.cs" Exclude="$(RulesSourceRoot)/Assets/_Project/Scripts/Rules/Wordbound/CourseTemplates.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Rules/Wordbound/CourseTemplates.cs" />
    <Compile Include="../../../wordbound-integration/Packages/com.gamestudiokit.core/Runtime/Determinism/*.cs" />
    <Compile Include="../../../wordbound-integration/Assets/_Project/Tests/Rules/TestData.cs" />
    <Compile Include="../../Assets/_Project/Tests/Rules/WordboundArenaResourceTests.cs" />
    <Compile Include="../../Assets/_Project/Tests/Rules/WordboundArenaSeedTests.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>
</Project>
