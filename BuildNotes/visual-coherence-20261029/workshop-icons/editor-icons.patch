+            {
+                var icon = LobbyIcons.Get(id);
+                Assert.IsNotNull(icon, id);
+                Assert.Greater(icon.rect.width, 0, id);
+                Assert.Greater(icon.rect.height, 0, id);
+                Assert.AreSame(icon, LobbyIcons.Get(id), "Repeated access reuses the icon: " + id);
