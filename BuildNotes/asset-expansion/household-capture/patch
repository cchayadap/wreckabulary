+                foreach (var proof in report.files)
+                {
+                    try { proof.after = FileHash(proof.path); proof.unchanged = proof.before == proof.after; }
+                    catch (Exception error) { report.error += "\nFile verification " + proof.path + ": " + error; }
+                }
+                foreach (var proof in report.materials)
+                {
+                    try
