+        [MenuItem("Wreckabulary/Authoring/Capture Household Review")]
+        public static void Run()
+        {
+            if (EditorApplication.isPlayingOrWillChangePlaymode || SystemInfo.graphicsDeviceType == GraphicsDeviceType.Null || !GraphicsSettings.currentRenderPipeline)
+                throw new InvalidOperationException("Capture in Edit Mode with the active render pipeline and a graphics device.");
+            string folder = Full(Output);
+            if (Directory.Exists(folder) || File.Exists(folder)) throw new IOException("Preserve existing capture output: " + folder);
+            var paths = Ids.Select((id, i) => WordboundHouseholdSetup.PrefabRoot + "/" + Categories[i] + "/" + id + ".prefab").ToArray();
+            var prefabs = paths.Select(AssetDatabase.LoadAssetAtPath<GameObject>).ToArray();
+            if (prefabs.Any(prefab => !prefab) || !AssetDatabase.LoadAssetAtPath<SceneAsset>(WordboundHouseholdSetup.ScenePath))
+                throw new InvalidOperationException("Create the eight saved Household prefabs and review scene before capturing.");
+            foreach (var prefab in prefabs)
+                if (prefab.GetComponentsInChildren<Component>(true).Any(component => !component || component is not (Transform or MeshFilter or MeshRenderer or BoxCollider)))
+                    throw new InvalidOperationException("This bounded preview accepts only rigid renderer prefabs and box colliders; inspect " + prefab.name);
+            var report = new Report { utc = DateTime.UtcNow.ToString("O"), unity = Application.unityVersion,
+                graphics = SystemInfo.graphicsDeviceType + ": " + SystemInfo.graphicsDeviceName, colorSpace = QualitySettings.activeColorSpace.ToString(), globalBefore = Global() };
+            var inputs = paths.Concat(new[] { WordboundHouseholdSetup.ScenePath, WordboundHouseholdSetup.SettingsPath, ScriptPath,
+                AssetDatabase.GetAssetPath(GraphicsSettings.currentRenderPipeline) }).Where(path => !string.IsNullOrEmpty(path)).ToArray();
+            var projectSettings = new[] { "ProjectSettings/GraphicsSettings.asset", "ProjectSettings/QualitySettings.asset", "ProjectSettings/EditorSettings.asset" };
+            var sourceFiles = Ids.Select(id => WordboundHouseholdSetup.SourceRoot + "/Source/Kenney/Models/" + id + ".fbx")
+                .Concat(new[] { WordboundHouseholdSetup.SourceRoot + "/Source/Kenney/License.txt", WordboundHouseholdSetup.SourceRoot + "/manifest.json" });
+            if (!Directory.Exists(Full(WordboundHouseholdSetup.SourceRoot))) throw new IOException("Missing Household source package directory.");
+            foreach (string path in inputs.Concat(projectSettings).Concat(sourceFiles))
+                if (!File.Exists(Full(path)) || path.StartsWith("Assets/", StringComparison.Ordinal) && !File.Exists(Full(path + ".meta")))
+                    throw new IOException("Missing required capture source or metadata: " + path);
+            var dependencies = AssetDatabase.GetDependencies(inputs, true);
+            if (dependencies.Any(path => path.StartsWith("Assets/", StringComparison.Ordinal) && !File.Exists(Full(path))))
+                throw new IOException("A saved Household project dependency is missing; inspect references before capture.");
+            report.excludedNonFileDependencies = dependencies.Where(path => !File.Exists(Full(path))).ToArray();
+            var files = dependencies.Where(path => File.Exists(Full(path))).Concat(inputs)
+                .Concat(Directory.GetFiles(Full(WordboundHouseholdSetup.SourceRoot), "*", SearchOption.AllDirectories).Select(Relative))
+                .Concat(projectSettings).SelectMany(path => new[] { path, path + ".meta" }).Distinct(StringComparer.Ordinal).OrderBy(path => path, StringComparer.Ordinal);
+            report.files = files.Select(path => new FileProof { path = path, before = FileHash(path) }).ToList();
+            report.materials = prefabs.SelectMany(prefab => prefab.GetComponentsInChildren<MeshRenderer>(true)).SelectMany(renderer => renderer.sharedMaterials)
+                .Where(material => material).Distinct().Select(material => new MaterialProof { source = material, path = AssetDatabase.GetAssetPath(material), name = material.name,
+                    shader = material.shader ? material.shader.name : "MISSING", baseColor = material.HasProperty("_BaseColor") ? material.GetColor("_BaseColor") : material.color,
+                    renderQueue = material.renderQueue, before = Hash(Encoding.UTF8.GetBytes(EditorJsonUtility.ToJson(material))), dirtyBefore = EditorUtility.IsDirty(material) }).ToList();
+            bool asyncShaders = EditorSettings.asyncShaderCompilation, ssao = Shader.IsKeywordEnabled("_SCREEN_SPACE_OCCLUSION");
+            var renderTexture = RenderTexture.active;
+            Directory.CreateDirectory(folder);
+            try
+            {
+                EditorSettings.asyncShaderCompilation = false;
+                Capture(report, folder, "gallery", prefabs, Enumerable.Range(0, 8).ToArray(), 4);
+                Capture(report, folder, "kitchen", prefabs, new[] { 0, 1, 2 }, 3);
+                Capture(report, folder, "attic", prefabs, new[] { 3, 4 }, 2);
+                Capture(report, folder, "rooftop-parcel", prefabs, new[] { 5, 6, 7 }, 3);
+                report.status = "CAPTURED_NOT_VISUALLY_APPROVED";
+            }
+            catch (Exception error) { report.error = error.ToString(); report.status = "FAIL"; }
+            finally
+            {
+                RenderTexture.active = renderTexture; EditorSettings.asyncShaderCompilation = asyncShaders;
+                if (ssao) Shader.EnableKeyword("_SCREEN_SPACE_OCCLUSION"); else Shader.DisableKeyword("_SCREEN_SPACE_OCCLUSION");
