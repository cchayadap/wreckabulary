+                        proof.after = proof.source ? Hash(Encoding.UTF8.GetBytes(EditorJsonUtility.ToJson(proof.source))) : "MISSING";
+                        proof.dirtyAfter = proof.source && EditorUtility.IsDirty(proof.source);
+                        proof.unchanged = proof.before == proof.after && proof.dirtyBefore == proof.dirtyAfter;
+                    }
+                    catch (Exception error) { report.error += "\nMaterial verification " + proof.path + ": " + error; }
+                }
+                report.sourceAndGlobalPreserved = report.globalBefore == report.globalAfter && report.files.All(proof => proof.unchanged) && report.materials.All(proof => proof.unchanged);
+                if (!report.sourceAndGlobalPreserved) { report.status = "FAIL"; report.error += "\nSource or global preservation failed; no source repair attempted."; }
+                if (report.error.Length != 0) report.status = "FAIL";
+                WriteNew(Path.Combine(folder, "receipt.json"), Encoding.UTF8.GetBytes(JsonUtility.ToJson(report, true)));
+            }
+            if (report.status == "FAIL") throw new InvalidOperationException("Household review capture failed; retain evidence at " + folder + "\n" + report.error);
+            Debug.Log("HOUSEHOLD_REVIEW_CAPTURE: " + folder + "; images=4; preserved=true; art acceptance pending.");
+        }
+
+        static void Capture(Report report, string folder, string name, GameObject[] prefabs, int[] indices, int columns)
+        {
+            var result = new View { name = name, image = name + ".png" }; report.views.Add(result);
+            PreviewRenderUtility preview = null; Texture2D image = null; bool begun = false; Scene scene = default;
+            var clones = new List<GameObject>();
+            try
+            {
+                preview = new PreviewRenderUtility(); scene = preview.camera.gameObject.scene;
+                if (!EditorSceneManager.IsPreviewScene(scene)) throw new InvalidOperationException("Expected an owned preview scene.");
+                bool first = true;
+                for (int i = 0; i < indices.Length; i++)
+                {
+                    int index = indices[i]; var clone = (GameObject)PrefabUtility.InstantiatePrefab(prefabs[index], scene); clones.Add(clone);
+                    if (!clone || clone.scene != scene) throw new InvalidOperationException("Prefab did not enter the owned preview scene.");
+                    clone.transform.position += new Vector3((i % columns) * 2.4f, 0f, (i / columns) * 3f);
+                    var bounds = VisibleBounds(clone);
+                    if (first) { result.bounds = bounds; first = false; } else result.bounds.Encapsulate(bounds);
+                    result.members.Add(new Member { id = Ids[index], bounds = bounds, scale = clone.transform.localScale });
+                }
+                var camera = preview.camera; camera.aspect = (float)Width / Height; camera.orthographic = true;
+                camera.nearClipPlane = .03f; camera.farClipPlane = 100f; camera.clearFlags = CameraClearFlags.SolidColor;
+                camera.backgroundColor = new Color(.075f, .09f, .11f); camera.allowHDR = false; camera.allowMSAA = false;
+                camera.transform.position = result.bounds.center + new Vector3(1.1f, .7f, -1.7f).normalized * Mathf.Max(12f, result.bounds.size.magnitude * 1.5f);
+                camera.transform.LookAt(result.bounds.center); float frame = .25f;
+                foreach (var point in Corners(result.bounds))
+                { var local = camera.transform.InverseTransformPoint(point); frame = Mathf.Max(frame, Mathf.Abs(local.y), Mathf.Abs(local.x) / camera.aspect); }
+                camera.orthographicSize = frame * 1.12f; result.orthographicSize = camera.orthographicSize;
+                result.cameraPosition = camera.transform.position; result.cameraEuler = camera.transform.eulerAngles;
+                preview.BeginStaticPreview(new Rect(0, 0, Width, Height)); begun = true;
+                foreach (var point in Corners(result.bounds))
+                {
+                    var view = camera.WorldToViewportPoint(point);
+                    if (view.x < 0f || view.x > 1f || view.y < 0f || view.y > 1f || view.z <= camera.nearClipPlane || view.z >= camera.farClipPlane)
+                        throw new InvalidOperationException("Household framing would clip saved geometry: " + name);
+                }
+                preview.ambientColor = new Color(.35f, .35f, .35f);
+                preview.lights[0].color = preview.lights[1].color = Color.white;
+                preview.lights[0].intensity = 1.1f; preview.lights[1].intensity = .6f;
+                preview.lights[0].transform.rotation = Quaternion.Euler(35f, -30f, 0f); preview.lights[1].transform.rotation = Quaternion.Euler(20f, 145f, 0f);
+                preview.Render(true); preview.Render(true); image = preview.EndStaticPreview(); begun = false;
+                result.ambient = preview.ambientColor; result.lightIntensities = preview.lights.Select(light => light.intensity).ToArray();
+                result.lightEuler = preview.lights.Select(light => light.transform.eulerAngles).ToArray();
+                if (!image || image.width != Width || image.height != Height) throw new InvalidOperationException("Invalid native capture dimensions.");
+                result.imageGraphicsFormat = image.graphicsFormat.ToString(); result.imageIsDataSRGB = image.isDataSRGB;
+                result.distinctRgb = image.GetPixels32().Select(color => color.r << 16 | color.g << 8 | color.b).Distinct().Take(4096).Count();
+                if (result.distinctRgb < 64) throw new InvalidOperationException("Capture lacks sufficient pixel variation; preserve this failure.");
+                byte[] bytes = image.EncodeToPNG(); result.sha256 = Hash(bytes); result.bytes = bytes.Length; WriteNew(Path.Combine(folder, result.image), bytes);
+            }
+            catch (Exception error) { result.error = error.ToString(); throw; }
+            finally
+            {
+                Clean(() => { if (begun) { var pending = preview.EndStaticPreview(); if (pending) Object.DestroyImmediate(pending); } }, result);
+                Clean(() => { if (image) Object.DestroyImmediate(image); }, result);
+                Clean(() => preview?.Cleanup(), result);
+                foreach (var clone in clones) Clean(() => { if (clone) Object.DestroyImmediate(clone); }, result);
+                Clean(() => { if (scene.IsValid() && scene.isLoaded && EditorSceneManager.IsPreviewScene(scene)) EditorSceneManager.ClosePreviewScene(scene); }, result);
+                result.remainingClones = clones.Count(clone => clone); result.previewClosed = !scene.IsValid() || !scene.isLoaded;
+            }
+            if (!string.IsNullOrEmpty(result.error) || result.remainingClones != 0 || !result.previewClosed || image)
+                throw new InvalidOperationException("Household preview cleanup failed: " + name + "\n" + result.error);
+        }
+
+        static Bounds VisibleBounds(GameObject model)
+        {
+            var renderers = model.GetComponentsInChildren<MeshRenderer>().Where(renderer => renderer.enabled && !renderer.forceRenderingOff).ToArray();
+            if (renderers.Length == 0) throw new InvalidOperationException("Saved Household prefab has no visible mesh renderers.");
+            var bounds = renderers[0].bounds; foreach (var renderer in renderers.Skip(1)) bounds.Encapsulate(renderer.bounds);
+            if (!Finite(bounds.center) || !Finite(bounds.size) || bounds.size.sqrMagnitude <= 0f || bounds.size.magnitude > 50f)
+                throw new InvalidOperationException("Saved Household dimensions are invalid for this bounded capture.");
+            return bounds;
+        }
+        static IEnumerable<Vector3> Corners(Bounds bounds)
+        { for (int i = 0; i < 8; i++) yield return bounds.center + Vector3.Scale(bounds.extents, new Vector3((i & 1) == 0 ? -1 : 1, (i & 2) == 0 ? -1 : 1, (i & 4) == 0 ? -1 : 1)); }
+        static string Global()
+        {
+            var scene = SceneManager.GetActiveScene();
+            return JsonUtility.ToJson(new GlobalState { active = scene.handle.GetRawData() + ":" + scene.path + ":" + scene.isDirty,
+                scenes = string.Join(";", Enumerable.Range(0, SceneManager.sceneCount).Select(i => { var s = SceneManager.GetSceneAt(i); return s.handle.GetRawData() + ":" + s.path + ":" + s.isDirty + ":" + string.Join(",", s.GetRootGameObjects().Select(root => root.GetEntityId().ToString())); })),
+                skybox = RenderSettings.skybox ? RenderSettings.skybox.GetEntityId().ToString() : "", sun = RenderSettings.sun ? RenderSettings.sun.GetEntityId().ToString() : "",
+                pipeline = AssetDatabase.GetAssetPath(GraphicsSettings.currentRenderPipeline), renderTexture = RenderTexture.active ? RenderTexture.active.GetEntityId().ToString() : "",
+                asyncShaders = EditorSettings.asyncShaderCompilation, ssao = Shader.IsKeywordEnabled("_SCREEN_SPACE_OCCLUSION"),
+                ambientMode = RenderSettings.ambientMode.ToString(), ambient = RenderSettings.ambientLight, sky = RenderSettings.ambientSkyColor,
+                equator = RenderSettings.ambientEquatorColor, ground = RenderSettings.ambientGroundColor, ambientIntensity = RenderSettings.ambientIntensity,
+                reflectionIntensity = RenderSettings.reflectionIntensity, fog = RenderSettings.fog, fogDensity = RenderSettings.fogDensity, fogColor = RenderSettings.fogColor });
+        }
+        static void Clean(Action action, View view) { try { action(); } catch (Exception error) { view.error += "\nCleanup: " + error; } }
+        static bool Finite(Vector3 value) => float.IsFinite(value.x) && float.IsFinite(value.y) && float.IsFinite(value.z);
+        static string Full(string path) => Path.GetFullPath(Path.Combine(Application.dataPath, "..", path));
+        static string Relative(string path) => Path.GetRelativePath(Full("."), path).Replace('\\', '/');
+        static string FileHash(string path) => File.Exists(Full(path)) ? Hash(File.ReadAllBytes(Full(path))) : "MISSING";
+        static string Hash(byte[] bytes) { using var sha = SHA256.Create(); return BitConverter.ToString(sha.ComputeHash(bytes)).Replace("-", "").ToLowerInvariant(); }
+        static void WriteNew(string path, byte[] bytes) { using var file = new FileStream(path, FileMode.CreateNew, FileAccess.Write, FileShare.None); file.Write(bytes, 0, bytes.Length); }
+    }
