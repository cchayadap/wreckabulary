+using System;
+using System.IO;
+using System.Linq;
+using System.Security.Cryptography;
+using UnityEditor;
+using UnityEditor.SceneManagement;
+using UnityEngine;
+using Wreckabulary.Art;
+using Object = UnityEngine.Object;
+
+namespace Wreckabulary.EditorTools
+{
+    public static class WordboundHouseholdSetup
+    {
+        public const string SourceRoot = "ArtSource/Collections/HouseholdExpansionV1";
+        public const string ArtRoot = "Assets/_Project/Art/Collections/HouseholdExpansionV1";
+        public const string PrefabRoot = "Assets/_Project/Prefabs/Furniture/HouseholdExpansionV1";
+        public const string SettingsPath = "Assets/_Project/Data/Wordbound/Authoring/HouseholdExpansion.asset";
+        public const string ScenePath = "Assets/_Project/Scenes/Authoring/HouseholdStudio.unity";
+        static readonly string[] Ids = { "kitchenStove", "kitchenFridge", "kitchenCabinet", "bookcaseClosedDoors", "cabinetBedDrawer", "pottedPlant", "bench", "cardboardBoxClosed" };
+        static readonly string[] Categories = { "Kitchen", "Kitchen", "Kitchen", "Attic", "Attic", "Rooftop", "Rooftop", "PackingYard" };
+        static readonly float[] Heights = { .9f, 1.8f, .9f, 1.8f, .6f, 1.2f, .9f, .45f };
+
+        [Serializable] sealed class FileRecord { public string packagePath, sha256; public long bytes; }
+        [Serializable] sealed class SourceBounds { public float[] size; }
+        [Serializable] sealed class Entry { public string id, category; public FileRecord sourceFile; public SourceBounds sourceBounds; }
+        [Serializable] sealed class License { public FileRecord evidence; }
+        [Serializable] sealed class Manifest { public int schemaVersion; public string package, status; public Entry[] entries; public License license; }
+
+        [MenuItem("Wreckabulary/Authoring/Create Missing Household Studio")]
+        public static void CreateOrVerify() => CreateAt(SourceRoot, ArtRoot, PrefabRoot, SettingsPath, ScenePath);
+
+        internal static void CreateAt(string sourceRoot, string artRoot, string prefabRoot, string settingsPath, string scenePath)
+        {
+            if (EditorApplication.isPlayingOrWillChangePlaymode) throw new InvalidOperationException("Create Household assets outside Play Mode.");
+            ValidatePath(sourceRoot, "ArtSource/Collections/", null);
+            ValidatePath(artRoot, "Assets/_Project/", null);
+            ValidatePath(prefabRoot, "Assets/_Project/", null);
+            ValidatePath(settingsPath, "Assets/_Project/", ".asset");
+            ValidatePath(scenePath, "Assets/_Project/", ".unity");
+            var source = ReadSource(sourceRoot);
+            CheckExisting<WordboundHouseholdSettings>(settingsPath);
+            CheckExisting<SceneAsset>(scenePath);
+            CheckCopy(source.license.evidence, artRoot + "/License.txt");
+            for (int i = 0; i < Ids.Length; i++)
+            {
+                CheckCopy(source.entries[i].sourceFile, artRoot + "/Models/" + Ids[i] + ".fbx");
+                CheckExisting<GameObject>(PrefabPath(prefabRoot, i));
+            }
+            var settings = AssetDatabase.LoadAssetAtPath<WordboundHouseholdSettings>(settingsPath);
+            if (settings) settings.Validate(Ids);
+            WorkspaceAssetCopies.EnsureFolder(artRoot + "/Models");
+            WorkspaceAssetCopies.EnsureFolder(artRoot + "/Materials");
+            if (!settings)
+            {
+                WorkspaceAssetCopies.EnsureFolder(Path.GetDirectoryName(settingsPath).Replace('\\', '/'));
+                settings = ScriptableObject.CreateInstance<WordboundHouseholdSettings>();
+                settings.items = Ids.Select((id, index) => new WordboundHouseholdSettings.Item { id = id, targetHeight = Heights[index] }).ToArray();
+                AssetDatabase.CreateAsset(settings, settingsPath);
+                AssetDatabase.SaveAssetIfDirty(settings);
+            }
+            CopyMissing(sourceRoot, source.license.evidence, artRoot + "/License.txt");
+            for (int i = 0; i < Ids.Length; i++)
+            {
+                string modelPath = artRoot + "/Models/" + Ids[i] + ".fbx";
+                if (CopyMissing(sourceRoot, source.entries[i].sourceFile, modelPath)) ConfigureImporter(modelPath);
+                ValidateImporter(modelPath);
+                var model = AssetDatabase.LoadAssetAtPath<GameObject>(modelPath);
+                if (!model || model.GetComponentsInChildren<MeshFilter>(true).Length == 0)
+                    throw new InvalidOperationException("Preserve and inspect incomplete model import: " + modelPath);
+                string prefabPath = PrefabPath(prefabRoot, i);
+                if (AssetDatabase.LoadAssetAtPath<GameObject>(prefabPath)) continue;
+                WorkspaceAssetCopies.EnsureFolder(Path.GetDirectoryName(prefabPath).Replace('\\', '/'));
+                CreatePrefab(model, source.entries[i], settings.items.Single(item => item.id == Ids[i]).targetHeight, prefabPath, artRoot);
+            }
+            string floorPath = artRoot + "/Materials/StudioFloor.mat";
+            var floor = CreateMaterialIfMissing(floorPath, new Color(.13f, .16f, .18f), 0f, .2f);
+            WorkspaceStudioSetup.CreateSceneIfMissing(scenePath, () => PopulateScene(prefabRoot, floor));
+            Debug.Log("HOUSEHOLD_STUDIO_READY: eight editable furniture prefabs, source-color materials, initial-size settings and saved review scene. Existing assets preserved. No gameplay registration; visual, joint and physics acceptance pending.");
+        }
+
+        static Manifest ReadSource(string root)
+        {
+            string path = root + "/manifest.json";
+            if (!File.Exists(path) || new FileInfo(path).Length > 256 * 1024) throw new InvalidOperationException("Missing or oversized Household source manifest.");
+            var manifest = JsonUtility.FromJson<Manifest>(File.ReadAllText(path));
+            if (manifest == null || manifest.schemaVersion != 1 || manifest.package != "HouseholdExpansionV1" || manifest.status != "STAGED_ONLY" ||
+                manifest.entries == null || manifest.entries.Length != Ids.Length || manifest.license?.evidence == null)
+                throw new InvalidOperationException("Expected the verified eight-model HouseholdExpansionV1 source package.");
+            for (int i = 0; i < Ids.Length; i++)
+            {
+                var entry = manifest.entries[i];
+                if (entry == null || entry.id != Ids[i] || entry.category != Categories[i] || entry.sourceBounds?.size == null ||
+                    entry.sourceBounds.size.Length != 3 || entry.sourceBounds.size.Any(value => !float.IsFinite(value) || value <= 0f))
+                    throw new InvalidOperationException("Unexpected Household source identity, order or dimensions.");
+                VerifyFile(root, entry.sourceFile, "Source/Kenney/Models/" + Ids[i] + ".fbx");
+            }
+            VerifyFile(root, manifest.license.evidence, "Source/Kenney/License.txt");
+            return manifest;
+        }
+
+        static void VerifyFile(string root, FileRecord file, string expected)
+        {
+            if (file == null || file.packagePath != expected || file.bytes <= 0 || file.bytes > 4 * 1024 * 1024 ||
+                file.sha256 == null || file.sha256.Length != 64 || file.sha256.Any(c => !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f')))
+                throw new InvalidOperationException("Unexpected Household source path, size or hash: " + expected);
+            string path = root + "/" + expected;
+            if (!File.Exists(path) || new FileInfo(path).Length != file.bytes || Hash(path) != file.sha256)
+                throw new InvalidOperationException("Source changed since verification: " + expected);
+        }
+
+        static void ConfigureImporter(string path)
+        {
+            var importer = AssetImporter.GetAtPath(path) as ModelImporter;
+            if (!importer) throw new InvalidOperationException("Expected an FBX importer: " + path);
+            importer.globalScale = 1f;
+            importer.useFileScale = true;
+            importer.bakeAxisConversion = true;
+            importer.importCameras = importer.importLights = importer.importVisibility = importer.importAnimation = importer.importBlendShapes = false;
+            importer.animationType = ModelImporterAnimationType.None;
+            importer.optimizeGameObjects = false;
+            importer.meshCompression = ModelImporterMeshCompression.Off;
+            importer.importNormals = ModelImporterNormals.Import;
+            importer.importTangents = ModelImporterTangents.None;
+            importer.addCollider = importer.isReadable = false;
+            importer.materialImportMode = ModelImporterMaterialImportMode.ImportViaMaterialDescription;
+            importer.materialLocation = ModelImporterMaterialLocation.InPrefab;
+            importer.SaveAndReimport();
+        }
+
+        static void ValidateImporter(string path)
+        {
+            var importer = AssetImporter.GetAtPath(path) as ModelImporter;
+            if (!importer || importer.importAnimation || importer.animationType != ModelImporterAnimationType.None ||
+                importer.importCameras || importer.importLights || importer.importBlendShapes || importer.addCollider ||
+                importer.optimizeGameObjects || !importer.useFileScale || !importer.bakeAxisConversion ||
+                importer.materialImportMode != ModelImporterMaterialImportMode.ImportViaMaterialDescription ||
+                importer.materialLocation != ModelImporterMaterialLocation.InPrefab)
+                throw new InvalidOperationException("Preserve and inspect changed or incomplete rigid-model import settings: " + path);
+        }
+
+        static void CreatePrefab(GameObject model, Entry entry, float height, string path, string artRoot)
+        {
+            var scene = EditorSceneManager.NewPreviewScene();
+            GameObject wrapper = null;
+            try
+            {
+                wrapper = new GameObject(entry.id + (entry.id == "cardboardBoxClosed" ? " · static parcel" : " · collision review pending"));
+                UnityEngine.SceneManagement.SceneManager.MoveGameObjectToScene(wrapper, scene);
+                var instance = (GameObject)PrefabUtility.InstantiatePrefab(model, wrapper.transform);
+                if (!instance) throw new InvalidOperationException("Could not instantiate Household model.");
+                foreach (var component in instance.GetComponentsInChildren<Component>(true))
+                    if (!component || component is not (Transform or MeshFilter or MeshRenderer))
+                        throw new InvalidOperationException("Expected rigid render-only furniture: " + entry.id);
+                var bounds = ModelVisual.BoundsIn(wrapper.transform, instance);
+                if (!FiniteBounds(bounds)) throw new InvalidOperationException("Furniture has invalid imported bounds: " + entry.id);
+                var expected = new Vector3(entry.sourceBounds.size[0], entry.sourceBounds.size[1], entry.sourceBounds.size[2]);
+                for (int axis = 0; axis < 3; axis++)
+                    if (Mathf.Abs(bounds.size[axis] - expected[axis]) > Mathf.Max(.002f, expected[axis] * .05f))
+                        throw new InvalidOperationException("Imported FBX dimensions differ from measured source; inspect axis/units: " + entry.id);
+                instance.transform.localScale *= height / bounds.size.y;
+                bounds = ModelVisual.BoundsIn(wrapper.transform, instance);
+                instance.transform.localPosition -= new Vector3(bounds.center.x, bounds.min.y, bounds.center.z);
+                foreach (var renderer in instance.GetComponentsInChildren<MeshRenderer>(true))
+                {
+                    renderer.sharedMaterials = renderer.sharedMaterials.Select(material =>
+                    {
+                        if (!material || !SafeName(material.name)) throw new InvalidOperationException("Invalid imported material name: " + entry.id);
+                        string materialPath = artRoot + "/Materials/" + entry.id + "/" + material.name + ".mat";
+                        Color color = material.HasProperty("_BaseColor") ? material.GetColor("_BaseColor") : material.color;
+                        float metallic = material.HasProperty("_Metallic") ? material.GetFloat("_Metallic") : 0f;
+                        float smoothness = material.HasProperty("_Smoothness") ? material.GetFloat("_Smoothness") : material.HasProperty("_Glossiness") ? material.GetFloat("_Glossiness") : .2f;
+                        return CreateMaterialIfMissing(materialPath, color, metallic, smoothness);
+                    }).ToArray();
+                    PrefabUtility.RecordPrefabInstancePropertyModifications(renderer);
+                }
+                PrefabUtility.RecordPrefabInstancePropertyModifications(instance.transform);
+                if (entry.id == "cardboardBoxClosed")
+                {
+                    bounds = ModelVisual.BoundsIn(wrapper.transform, instance);
+                    var collider = wrapper.AddComponent<BoxCollider>();
+                    collider.center = bounds.center;
+                    collider.size = bounds.size;
+                }
+                if (!PrefabUtility.SaveAsPrefabAsset(wrapper, path)) throw new IOException("Could not save Household wrapper: " + path);
+            }
+            finally
+            {
+                if (wrapper) Object.DestroyImmediate(wrapper);
+                EditorSceneManager.ClosePreviewScene(scene);
+            }
+        }
+
+        static Material CreateMaterialIfMissing(string path, Color color, float metallic, float smoothness)
+        {
+            CheckExisting<Material>(path);
+            var existing = AssetDatabase.LoadAssetAtPath<Material>(path);
+            if (existing) return existing;
+            if (!float.IsFinite(color.r) || !float.IsFinite(color.g) || !float.IsFinite(color.b) || !float.IsFinite(color.a) ||
+                !float.IsFinite(metallic) || !float.IsFinite(smoothness)) throw new InvalidOperationException("Imported material values must be finite.");
+            var shader = Shader.Find("Universal Render Pipeline/Lit");
+            if (!shader) throw new InvalidOperationException("Household materials require URP Lit.");
+            WorkspaceAssetCopies.EnsureFolder(Path.GetDirectoryName(path).Replace('\\', '/'));
+            var material = new Material(shader) { name = Path.GetFileNameWithoutExtension(path) };
+            material.SetColor("_BaseColor", color);
+            material.SetFloat("_Metallic", Mathf.Clamp01(metallic));
+            material.SetFloat("_Smoothness", Mathf.Clamp01(smoothness));
+            if (color.a < .999f)
+            {
+                material.SetFloat("_Surface", 1f);
+                material.SetFloat("_Blend", 0f);
+                material.SetFloat("_SrcBlend", (float)UnityEngine.Rendering.BlendMode.SrcAlpha);
+                material.SetFloat("_DstBlend", (float)UnityEngine.Rendering.BlendMode.OneMinusSrcAlpha);
+                material.SetFloat("_ZWrite", 0f);
+                material.EnableKeyword("_SURFACE_TYPE_TRANSPARENT");
+                material.SetOverrideTag("RenderType", "Transparent");
+                material.renderQueue = (int)UnityEngine.Rendering.RenderQueue.Transparent;
+                material.SetShaderPassEnabled("ShadowCaster", false);
+            }
+            AssetDatabase.CreateAsset(material, path);
+            AssetDatabase.SaveAssetIfDirty(material);
+            return material;
+        }
+
+        static void PopulateScene(string prefabs, Material floorMaterial)
+        {
+            var gallery = new GameObject("Household · visual and physics review pending");
+            for (int i = 0; i < Ids.Length; i++)
+            {
+                var prefab = AssetDatabase.LoadAssetAtPath<GameObject>(PrefabPath(prefabs, i));
+                if (!prefab) throw new InvalidOperationException("Missing Household prefab: " + Ids[i]);
+                var item = (GameObject)PrefabUtility.InstantiatePrefab(prefab, gallery.transform);
+                item.transform.localPosition = new Vector3((i % 4) * 2.4f, 0f, (i / 4) * 3f);
+                PrefabUtility.RecordPrefabInstancePropertyModifications(item.transform);
+            }
+            var floor = GameObject.CreatePrimitive(PrimitiveType.Cube);
+            floor.name = "Review floor";
+            floor.transform.position = new Vector3(3.6f, -.06f, 1.5f);
+            floor.transform.localScale = new Vector3(11f, .1f, 7f);
+            floor.GetComponent<MeshRenderer>().sharedMaterial = floorMaterial;
+            Object.DestroyImmediate(floor.GetComponent<Collider>());
+            var camera = new GameObject("Review Camera").AddComponent<Camera>();
+            camera.tag = "MainCamera";
+            camera.transform.position = new Vector3(11f, 9f, -12f);
+            camera.transform.LookAt(new Vector3(3.6f, .7f, 1.5f));
+            camera.orthographic = true;
+            camera.orthographicSize = 5.5f;
+            camera.clearFlags = CameraClearFlags.SolidColor;
+            camera.backgroundColor = new Color(.07f, .09f, .11f);
+            camera.nearClipPlane = .05f;
+            camera.farClipPlane = 100f;
+            var light = new GameObject("Review Key").AddComponent<Light>();
+            light.type = LightType.Directional;
+            light.intensity = 1.2f;
+            light.transform.rotation = Quaternion.Euler(45f, -35f, 0f);
+        }
+
+        static bool CopyMissing(string root, FileRecord file, string target)
+        {
+            CheckCopy(file, target);
+            if (File.Exists(target)) return false;
+            File.Copy(root + "/" + file.packagePath, target, false);
+            AssetDatabase.ImportAsset(target, ImportAssetOptions.ForceSynchronousImport);
+            return true;
+        }
+        static void CheckCopy(FileRecord file, string target)
+        {
+            if (File.Exists(target))
+            {
+                if (Hash(target) != file.sha256) throw new IOException("Preserve changed imported source: " + target);
+                if (!AssetDatabase.LoadMainAssetAtPath(target)) throw new IOException("Preserve unimported source and inspect: " + target);
+            }
+            else if (File.Exists(target + ".meta") || Directory.Exists(target) || AssetDatabase.LoadMainAssetAtPath(target))
+                throw new IOException("Preserve conflicting destination: " + target);
+        }
+        static void CheckExisting<T>(string path) where T : Object
+        {
+            var asset = AssetDatabase.LoadMainAssetAtPath(path);
+            if (asset is T) return;
+            if (asset || File.Exists(path) || Directory.Exists(path) || File.Exists(path + ".meta")) throw new IOException("Preserve conflicting destination: " + path);
+        }
+        static void ValidatePath(string path, string prefix, string extension)
+        {
+            if (string.IsNullOrEmpty(path) || !path.StartsWith(prefix, StringComparison.Ordinal) || path.Contains('\\') ||
+                path.Split('/').Any(part => !SafeName(part)) || extension != null && Path.GetExtension(path) != extension)
+                throw new ArgumentException("Use a project-relative path inside " + prefix + " with the expected file type.");
+        }
+        static bool SafeName(string value) => !string.IsNullOrEmpty(value) && value != "." && value != ".." && value.TrimEnd(' ', '.') == value && value.IndexOfAny(Path.GetInvalidFileNameChars()) < 0;
+        static bool FiniteBounds(Bounds bounds) => float.IsFinite(bounds.center.x) && float.IsFinite(bounds.center.y) && float.IsFinite(bounds.center.z) &&
+            float.IsFinite(bounds.size.x) && float.IsFinite(bounds.size.y) && float.IsFinite(bounds.size.z) && bounds.size.x > 0f && bounds.size.y > 0f && bounds.size.z > 0f;
+        static string PrefabPath(string root, int index) => root + "/" + Categories[index] + "/" + Ids[index] + ".prefab";
+        static string Hash(string path)
+        {
+            using var sha = SHA256.Create();
+            using var stream = File.OpenRead(path);
+            return BitConverter.ToString(sha.ComputeHash(stream)).Replace("-", "").ToLowerInvariant();
+        }
+    }
+}
