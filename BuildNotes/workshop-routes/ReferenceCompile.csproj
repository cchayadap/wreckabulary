<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <UnityData>C:/Program Files/Unity/Hub/Editor/6000.6.3f1/Editor/Data</UnityData>
    <IntegrationRoot Condition="'$(IntegrationRoot)' == ''">../../../wordbound-integration</IntegrationRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(IntegrationRoot)/Assets/_Project/Scripts/Rules/**/*.cs"
      Exclude="$(IntegrationRoot)/Assets/_Project/Scripts/Rules/Wordbound/WorkshopRoutes.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Rules/Wordbound/WorkshopRoutes.cs" />
    <Compile Include="$(IntegrationRoot)/Packages/com.gamestudiokit.core/Runtime/Determinism/*.cs" />
    <Compile Include="$(IntegrationRoot)/Assets/_Project/Scripts/Workshop/Wordbound*.cs"
      Exclude="$(IntegrationRoot)/Assets/_Project/Scripts/Workshop/WordboundWorkshopRoutes.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Workshop/WordboundWorkshopRoutes.cs" />
    <Reference Include="$(UnityData)/NetStandard/ref/2.1.0/netstandard.dll" Private="false" />
    <Reference Include="$(UnityData)/Managed/UnityEngine/UnityEngine*.dll" Private="false" />
    <Reference Include="$(IntegrationRoot)/Library/ScriptAssemblies/Wreckabulary.dll" Private="false" />
    <Reference Include="$(IntegrationRoot)/Library/ScriptAssemblies/Unity.InputSystem.dll" Private="false" />
  </ItemGroup>
</Project>
