<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IntegrationRoot Condition="'$(IntegrationRoot)' == ''">../../../wordbound-integration</IntegrationRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(IntegrationRoot)/Assets/_Project/Scripts/Rules/**/*.cs"
      Exclude="$(IntegrationRoot)/Assets/_Project/Scripts/Rules/Wordbound/WorkshopRoutes.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Rules/Wordbound/WorkshopRoutes.cs" />
    <Compile Include="$(IntegrationRoot)/Packages/com.gamestudiokit.core/Runtime/Determinism/*.cs" />
    <Compile Include="../../Assets/_Project/Tests/Rules/WorkshopRoutesTests.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>
</Project>
