diff --git a/Assets/_Project/Scripts/UI/Lobby/LobbyHomeDefaultLayout.cs b/Assets/_Project/Scripts/UI/Lobby/LobbyHomeDefaultLayout.cs
new file mode 100644
index 00000000..f76bde6b
