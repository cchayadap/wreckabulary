+        static WindingStats MeasureWinding(Mesh mesh, int submesh, Vector3[] vertices, Vector3[] normals,
+            Matrix4x4 worldMatrix, Matrix4x4 normalMatrix)
+        {
+            if (mesh.GetTopology(submesh) != MeshTopology.Triangles)
