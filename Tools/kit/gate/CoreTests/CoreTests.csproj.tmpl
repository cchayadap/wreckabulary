<Project>
  <!--
    Game Studio Kit, rung R1: the engine-free assemblies (@@CORE_ASMDEFS@@) and their pure tests under plain .NET, in
    seconds and without Unity. Anything in them that touches UnityEngine fails to compile here. Adapted from KNOTWELL
    Tools/CoreTests; the Newtonsoft reference uses the @* wildcard instead of a package-hash pin.
    Generated by gen_asmdef_checks.mjs from CoreTests.csproj.tmpl; do not edit.
    Knob set by the gate: -p:KitSlot=N (own bin/obj per concurrent run).
  -->
  <PropertyGroup>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <KitSlot Condition="'$(KitSlot)' == ''">0</KitSlot>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj\$(KitSlot)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)bin\$(KitSlot)\</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>@@CORE_TFM@@</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ProjectRoot>$(MSBuildThisFileDirectory)@@PROJECT_ROOT_REL@@</ProjectRoot>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
@@COMPILE_ITEMS@@
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(ProjectRoot)Library\PackageCache\com.unity.nuget.newtonsoft-json@*\Runtime\Newtonsoft.Json.dll" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
