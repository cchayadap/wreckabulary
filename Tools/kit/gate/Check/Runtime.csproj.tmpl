<Project Sdk="Microsoft.NET.Sdk">
  <!--
    R0 whole-project check, runtime code (generated by gen_asmdef_checks.mjs from Runtime.csproj.tmpl; do not edit):
    every .cs under the code roots except Editor and Tests folders and Editor-only or test asmdefs, compiled as one
    assembly. Asmdef boundaries are checked by `game_gate check asmdef`.
  -->
  <PropertyGroup>
    <AssemblyName>GskCheck.Runtime</AssemblyName>
    <KitScriptAssemblies>runtime</KitScriptAssemblies>
    <KitNewtonsoft>true</KitNewtonsoft>
    <DefineConstants>$(DefineConstants);@@VERSION_DEFINES@@</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
@@COMPILE_ITEMS@@
  </ItemGroup>
</Project>
