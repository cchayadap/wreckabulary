<Project>
  <!--
    Game Studio Kit, rung R0: type-check the project's C# with plain `dotnet build` against the editor's reference
    assemblies, without opening Unity (one Unity process per project). Adapted from KNOTWELL Tools/Check.
    Generated by gen_asmdef_checks.mjs from Directory.Build.props.tmpl; do not edit (it is rewritten when asmdefs change).
    No IL post-processors run here: `game_gate compile` (R2/R3) stays authoritative.
    Knobs set by the gate: -p:KitSlot=N (own bin/obj per concurrent check), -p:UnityEditorDir=<editor folder>.
    Knobs set by the projects: KitNoEngine, KitEditor, KitTests, KitNewtonsoft, KitScriptAssemblies (runtime|editor).
  -->
  <PropertyGroup>
    <UnityEditorDir Condition="'$(UnityEditorDir)' == ''">@@UNITY_EDITOR_DIR@@</UnityEditorDir>
    <UnityData>$(UnityEditorDir)\Data</UnityData>
    <ProjectRoot>$(MSBuildThisFileDirectory)@@PROJECT_ROOT_REL@@</ProjectRoot>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS1701;CS1702;CS0436;MSB3277</NoWarn>
    <KitSlot Condition="'$(KitSlot)' == ''">0</KitSlot>
    <BaseOutputPath>$(MSBuildThisFileDirectory)bin\$(KitSlot)\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj\$(KitSlot)\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <DefineConstants>@@DEFINES@@</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(UnityData)\NetStandard\ref\2.1.0\netstandard.dll" Private="false" />
    <Reference Include="$(UnityData)\Managed\UnityEngine\UnityEngine*.dll" Private="false" Condition="'$(KitNoEngine)' != 'true'" />
    <Reference Include="$(UnityData)\Managed\UnityEditor*.dll" Private="false" Condition="'$(KitEditor)' == 'true' and '$(KitNoEngine)' != 'true'" />
    <Reference Include="$(UnityData)\Managed\UnityEngine\UnityEditor*.dll" Private="false" Condition="'$(KitEditor)' == 'true' and '$(KitNoEngine)' != 'true'" />
    <Reference Include="$(ProjectRoot)Library\PackageCache\com.unity.nuget.newtonsoft-json@*\Runtime\Newtonsoft.Json.dll" Private="false" Condition="'$(KitNewtonsoft)' == 'true'" />
    <Reference Include="$(ProjectRoot)Library\ScriptAssemblies\*.dll" Exclude="@@SA_EXCLUDES_RUNTIME@@" Private="false" Condition="'$(KitScriptAssemblies)' == 'runtime'" />
    <Reference Include="$(ProjectRoot)Library\ScriptAssemblies\*.dll" Exclude="@@SA_EXCLUDES_EDITOR@@" Private="false" Condition="'$(KitScriptAssemblies)' == 'editor'" />
  </ItemGroup>
  <ItemGroup Condition="'$(KitTests)' == 'true'">
    <Reference Include="$(ProjectRoot)Library\PackageCache\com.unity.ext.nunit*\net40\unity-custom\nunit.framework.dll" Private="false" />
    <!-- nunit.framework targets net40, so it needs the mscorlib/System facades. -->
    <Reference Include="$(UnityData)\NetStandard\compat\2.1.0\shims\netfx\mscorlib.dll" Private="false" />
    <Reference Include="$(UnityData)\NetStandard\compat\2.1.0\shims\netfx\System.dll" Private="false" />
    <Reference Include="$(UnityData)\NetStandard\compat\2.1.0\shims\netfx\System.Core.dll" Private="false" />
  </ItemGroup>
</Project>
