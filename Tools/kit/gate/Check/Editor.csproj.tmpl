<Project Sdk="Microsoft.NET.Sdk">
  <!--
    R0 whole-project check, everything (runtime + Editor + Tests) with UNITY_EDITOR and the editor and test references
    (generated by gen_asmdef_checks.mjs from Editor.csproj.tmpl; do not edit).
  -->
  <PropertyGroup>
    <AssemblyName>GskCheck.Editor</AssemblyName>
    <KitEditor>true</KitEditor>
    <KitTests>true</KitTests>
    <KitScriptAssemblies>editor</KitScriptAssemblies>
    <KitNewtonsoft>true</KitNewtonsoft>
    <DefineConstants>$(DefineConstants);@@EDITOR_DEFINES@@</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
@@COMPILE_ITEMS@@
  </ItemGroup>
</Project>
