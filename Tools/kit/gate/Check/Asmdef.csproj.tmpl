<Project Sdk="Microsoft.NET.Sdk">
  <!--
    R0 per-asmdef check for @@ASMDEF_FILE@@ (generated by gen_asmdef_checks.mjs from Asmdef.csproj.tmpl; do not edit).
    Compiles one assembly with only the references its asmdef declares (no transitive references, as in Unity), so a
    missing reference, a layer break or UnityEngine inside an engine-free assembly fails in seconds.
  -->
  <PropertyGroup>
    <AssemblyName>@@NAME@@</AssemblyName>
    <KitNoEngine>@@NO_ENGINE@@</KitNoEngine>
    <KitEditor>@@EDITOR@@</KitEditor>
    <KitTests>@@TESTS@@</KitTests>
    <KitNewtonsoft>@@NEWTONSOFT@@</KitNewtonsoft>
    <AllowUnsafeBlocks>@@UNSAFE@@</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);@@DEFINES@@</DefineConstants>
    <DefineConstants Condition="'$(KitEditor)' == 'true'">$(DefineConstants);UNITY_EDITOR;UNITY_EDITOR_WIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
@@COMPILE_ITEMS@@
@@REFERENCES@@
  </ItemGroup>
</Project>
