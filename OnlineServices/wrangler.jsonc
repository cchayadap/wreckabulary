{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wreckabulary-wordbound-coordinator",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.1, "logs": { "enabled": true, "invocation_logs": false } },
  "vars": {
    "TOKEN_ISSUER": "wordbound-local",
    "SIGNING_KEY_ID": "local-unconfigured",
    "BUILTIN_CONTENT_JSON": "[]"
  },
  "durable_objects": {
    "bindings": [
      { "name": "IDENTITIES", "class_name": "Identity" },
      { "name": "PARTIES", "class_name": "Party" },
      { "name": "POOLS", "class_name": "MatchPool" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Identity", "Party", "MatchPool"] }
  ]
}
