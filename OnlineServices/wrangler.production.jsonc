{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wreckabulary-wordbound-coordinator",
  "account_id": "d105a82bc26b6913575355352c2d1bb1",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "redact_query_string": true,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "vars": {
    "TOKEN_ISSUER": "wreckabulary-wordbound",
    "SIGNING_KEY_ID": "wordbound-rs256-20261020-01",
    "BUILTIN_CONTENT_JSON": "[]",
    "PHOTON_APP_ID": "f6fb7f4c-b8a9-44a3-ac63-bee1c5f23552"
  },
  "durable_objects": {
    "bindings": [
      { "name": "IDENTITIES", "class_name": "Identity" },
      { "name": "PARTIES", "class_name": "Party" },
      { "name": "POOLS", "class_name": "MatchPool" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Identity", "Party", "MatchPool"] }
  ]
}
