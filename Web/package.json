{
  "name": "wreckabulary-browser",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "dev": "npm run sync-data && vite --host 0.0.0.0",
    "build": "npm run sync-data && node scripts/build-info.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "playwright": "1.55.1",
    "prettier": "3.6.2",
    "vite": "7.1.12"
  }
}
