.inventory-screen {
    --primary-color: #1E1E24;
    --accent-color: #D1A153;
    --text-color: #FFF5D9;
    --muted-color: #ACACB7;
    --teal-color: #4AE0BD;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(15, 15, 20, 0.82);
    padding: 3%;
    color: var(--text-color);
    font-size: 18px;
}
.inventory-shell {
    width: 94%;
    max-width: 1600px;
    height: 92%;
    max-height: 960px;
    background-color: var(--primary-color);
    border-radius: 20px;
    border-width: 2px;
    border-color: var(--accent-color);
    padding: 26px;
}
.inventory-header { flex-direction: row; align-items: center; flex-shrink: 0; height: 62px; margin-bottom: 20px; }
.screen-title { font-size: 32px; -unity-font-style: bold; color: var(--accent-color); }
.capacity { flex-grow: 1; margin-left: 24px; color: var(--muted-color); }
.inventory-body { flex-direction: row; flex-grow: 1; min-height: 0; }
.items-panel { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; margin-right: 24px; }
.filter-row { flex-direction: row; flex-shrink: 0; margin-bottom: 12px; }
.filter { min-width: 80px; min-height: 42px; margin-right: 8px; padding: 8px 14px; color: var(--muted-color); background-color: #2A2A32; border-radius: 8px; border-width: 1px; border-color: #41414D; }
.filter.selected { color: var(--primary-color); background-color: var(--accent-color); border-color: var(--accent-color); }
.item-scroll { flex-grow: 1; min-height: 0; }
.item-grid { flex-direction: row; flex-wrap: wrap; align-content: flex-start; padding: 3px; }
.item-card {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: 23%;
    width: 23%;
    min-width: 0;
    height: 158px;
    margin: 1%;
    padding: 10px;
    background-color: #2A2A32;
    border-width: 2px;
    border-color: #40404B;
    border-radius: 12px;
    align-items: center;
    justify-content: center;
}
.item-card.selected { background-color: #393228; border-color: var(--accent-color); }
.item-card:hover { background-color: #383842; border-color: var(--teal-color); }
.item-card:focus, .filter:focus, .button:focus { border-color: var(--teal-color); }
.item-icon { width: 100%; height: 100px; -unity-background-scale-mode: scale-to-fit; }
.item-name { color: var(--text-color); font-size: 17px; -unity-font-style: bold; margin-top: 6px; }
.stats-panel { width: 28%; min-width: 250px; max-width: 400px; flex-shrink: 0; align-self: stretch; padding: 22px; border-radius: 12px; background-color: #292930; border-left-width: 3px; border-left-color: var(--accent-color); }
.item-title { font-size: 30px; -unity-font-style: bold; color: var(--accent-color); }
.selected-preview { height: 180px; min-height: 90px; flex-shrink: 1; width: 100%; -unity-background-scale-mode: scale-to-fit; margin: 12px 0; }
.stat-row { flex-direction: row; flex-shrink: 0; justify-content: space-between; padding: 12px 0; border-bottom-width: 1px; border-bottom-color: #41414B; color: var(--muted-color); }
.stat-value { color: var(--text-color); -unity-font-style: bold; }
.stats-spacer { flex-grow: 1; min-height: 16px; }
.button { min-height: 48px; padding: 10px 18px; border-width: 2px; border-radius: 9px; -unity-font-style: bold; }
.primary { background-color: var(--accent-color); color: var(--primary-color); border-color: var(--accent-color); margin-bottom: 10px; }
.secondary { background-color: #34343F; color: var(--text-color); border-color: #52525D; }
.icon-ball { background-image: resource("UI/Items/BALL"); }
.icon-bat { background-image: resource("UI/Items/BAT"); }
.icon-bed { background-image: resource("UI/Items/BED"); }
.icon-blade { background-image: resource("UI/Items/BLADE"); }
.icon-bomb { background-image: resource("UI/Items/BOMB"); }
.icon-foam { background-image: resource("UI/Items/FOAM"); }
.icon-lamp { background-image: resource("UI/Items/LAMP"); }
.icon-mat { background-image: resource("UI/Items/MAT"); }
.icon-plate { background-image: resource("UI/Items/PLATE"); }
.icon-soap { background-image: resource("UI/Items/SOAP"); }
.icon-sofa { background-image: resource("UI/Items/SOFA"); }
.icon-table { background-image: resource("UI/Items/TABLE"); }
