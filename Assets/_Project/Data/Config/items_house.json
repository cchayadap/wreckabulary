  "tuning": {
    "note": "House-only balance. Tier comes from how hard the word is to spell; plain words carry nothing. Traits land every hit, by chance (chance), on every Nth hit on the same target (every), over time (Bleed, which may deepen up to stacks) or constantly while held (Guard, Swift). items.json and rules.json stay byte-identical for Wordbound and online.",
    "timersNote": "House rounds follow the house sizes: the houses are twice as wide and deep (the courtyard 1.5 times) and have about twice the rooms, so rounds run longer and the Movers close a room more often. Only roundTimeLimit and clearOut timings may be overridden here.",
    "unarmed": {
      "damage": 3
    },
    "modes": {
      "Dibs": {
        "roundTimeLimit": 210,
        "clearOut": {
          "firstAt": 45,
          "interval": 18
        }
